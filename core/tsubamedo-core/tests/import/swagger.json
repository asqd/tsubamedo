{
  "swagger": "2.0",
  "info": { "title": "Old API", "version": "1" },
  "host": "old.test",
  "basePath": "/api/",
  "schemes": ["http", "https"],
  "securityDefinitions": { "basic": { "type": "basic" } },
  "security": [ { "basic": [] } ],
  "paths": {
    "/users": {
      "post": {
        "summary": "Создать",
        "parameters": [ { "in": "body", "name": "body", "schema": { "$ref": "#/definitions/User" } } ],
        "responses": { "201": { "description": "ok" } }
      }
    },
    "/login": {
      "post": {
        "consumes": ["application/x-www-form-urlencoded"],
        "parameters": [
          { "in": "formData", "name": "user", "type": "string", "required": true },
          { "in": "formData", "name": "remember", "type": "boolean", "default": true }
        ],
        "responses": { "200": { "description": "ok" } }
      }
    }
  },
  "definitions": { "User": { "type": "object", "properties": { "name": { "type": "string" }, "age": { "type": "integer" } } } }
}
